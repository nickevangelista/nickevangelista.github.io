#!/usr/bin/env python3
"""Publish an Obsidian note as a note on the site.

Usage: publicar "path/to/Note.md"
       publicar --preview "path/to/Note.md"

Creates content/notes/<slug>/index.md, converts Obsidian-only syntax
([[links]], ![[images]], %%comments%%), copies images next to the post (resized to 1600 px and stripped of
metadata such as GPS location), checks the Hugo build, commits, and asks before pushing.

--preview runs the site locally with the note as a draft and re-converts it
every time the file is saved, so the browser shows the real rendering while
you write. Nothing is written to the repo.
"""

import argparse
import re
import shutil
import subprocess
import sys
import tempfile
import time
import unicodedata
import urllib.parse
import urllib.request
import webbrowser
from datetime import date
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
POSTS = REPO / "content" / "notes"
MAX_WIDTH = 1600
RESIZABLE = {".png", ".jpg", ".jpeg", ".webp"}


def slugify(text):
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def find_vault(note):
    for parent in note.parents:
        if (parent / ".obsidian").is_dir():
            return parent
    return note.parent


def find_file(name, note, vault):
    direct = (note.parent / name).resolve()
    if direct.is_file():
        return direct
    for found in vault.rglob(Path(name).name):
        if ".trash" not in found.parts:
            return found
    return None


def split_front_matter(text):
    m = re.match(r"^---\n(.*?)\n---\n?", text, re.S)
    if not m:
        return [], text
    return m.group(1).splitlines(), text[m.end():]


def set_field(lines, key, value, overwrite):
    for i, line in enumerate(lines):
        if re.match(rf"^{key}\s*:", line):
            if overwrite:
                lines[i] = f"{key}: {value}"
            return
    lines.append(f"{key}: {value}")


def get_field(lines, key):
    for line in lines:
        m = re.match(rf"^{key}\s*:\s*(.*)$", line)
        if m:
            return m.group(1).strip().strip("\"'")
    return None


def note_slug(note):
    meta, _ = split_front_matter(note.read_text())
    title = get_field(meta, "title") or note.stem
    return title, slugify(title)


def convert(note, bundle, draft):
    """Write the note as bundle/index.md with its images. Returns the missing files."""
    vault = find_vault(note)
    meta, body = split_front_matter(note.read_text())
    title = get_field(meta, "title") or note.stem
    published = POSTS / bundle.name / "index.md"

    # Republishing keeps the original date.
    old_date = get_field(split_front_matter(published.read_text())[0], "date") if published.exists() else None
    set_field(meta, "title", f'"{title}"', overwrite=True)
    set_field(meta, "date", old_date or date.today().isoformat(), overwrite=old_date is not None)
    set_field(meta, "draft", "true" if draft else "false", overwrite=True)

    bundle.mkdir(parents=True, exist_ok=True)
    missing = []

    def copy_image(name):
        src = find_file(name, note, vault)
        if not src:
            missing.append(name)
            return name
        dest = slugify(src.stem) + src.suffix.lower()
        out = bundle / dest
        if out.exists() and out.stat().st_mtime >= src.stat().st_mtime:
            return dest
        if src.suffix.lower() in RESIZABLE and shutil.which("magick"):
            # -strip drops EXIF, including the GPS position phone photos carry.
            subprocess.run(
                ["magick", str(src), "-auto-orient", "-strip", "-resize", f"{MAX_WIDTH}x>", str(out)],
                check=True,
            )
        else:
            shutil.copy2(src, out)
        return dest

    def embed(m):
        target, _, extra = (part.strip() for part in m.group(1).partition("|"))
        # ![[img.png|300]] is a width (dropped); ![[img.png|A caption]] becomes the alt text.
        alt = "" if re.fullmatch(r"\d+(x\d+)?", extra) else extra
        if Path(target).suffix.lower() in {".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg"}:
            return f"![{alt}]({copy_image(target)})"
        missing.append(target)
        return ""

    def markdown_image(m):
        alt, target = m.group(1), m.group(2).strip("<>")
        if re.match(r"^[a-z]+://", target):
            return m.group(0)
        target = urllib.parse.unquote(target)
        return f"![{alt}]({copy_image(target)})"

    def wikilink(m):
        target, _, alias = m.group(1).partition("|")
        return alias or target.split("#")[0]

    body = re.sub(r"%%.*?%%", "", body, flags=re.S)
    body = re.sub(r"!\[([^\]]*)\]\((<[^>]+>|[^)\s]+)\)", markdown_image, body)
    body = re.sub(r"!\[\[(.+?)\]\]", embed, body)
    body = re.sub(r"\[\[(.+?)\]\]", wikilink, body)

    (bundle / "index.md").write_text("---\n" + "\n".join(meta) + "\n---\n\n" + body.lstrip())
    return missing


def report_missing(missing):
    if missing:
        print("Warning: these files were not found (the rest of the note was converted):")
        for name in missing:
            print(f"  - {name}")


def publish(note):
    title, slug = note_slug(note)
    if (POSTS / f"{slug}.md").exists():
        sys.exit(f"content/notes/{slug}.md already exists. Rename the note or delete the old post.")
    bundle = POSTS / slug
    report_missing(convert(note, bundle, draft=False))
    print(f"Wrote {(bundle / 'index.md').relative_to(REPO)}")

    with tempfile.TemporaryDirectory() as out:
        build = subprocess.run(["mise", "exec", "--", "hugo", "--quiet", "-d", out], cwd=REPO)
    if build.returncode != 0:
        sys.exit("Hugo build failed. Nothing was committed.")

    subprocess.run(["git", "add", str(bundle)], cwd=REPO, check=True)
    if subprocess.run(["git", "diff", "--cached", "--quiet"], cwd=REPO).returncode == 0:
        print("Nothing changed since the last publish.")
        return
    subprocess.run(["git", "commit", "-q", "-m", f"note: {title}"], cwd=REPO, check=True)
    print(f"Committed. To preview first: publicar --preview \"{note}\"")

    if input("Push and publish now? [y/N] ").strip().lower() == "y":
        subprocess.run(["git", "push"], cwd=REPO, check=True)
        print("Pushed. The site updates in about 2 minutes: https://nickevangelista.github.io/")
    else:
        print("Not pushed. When ready: git push")


def preview(note, port):
    title, slug = note_slug(note)
    with tempfile.TemporaryDirectory(prefix="publicar-preview-") as tmp:
        tmp = Path(tmp)
        bundle = tmp / "content" / "notes" / slug
        # The preview mounts its own content dir next to the repo's, hiding the
        # published copy of this note if there is one. The repo is never touched.
        (tmp / "preview.toml").write_text(
            "[module]\n"
            "  [[module.mounts]]\n"
            '    source = "content"\n'
            '    target = "content"\n'
            f'    excludeFiles = ["notes/{slug}/**", "notes/{slug}.md"]\n'
            "  [[module.mounts]]\n"
            f'    source = "{tmp / "content"}"\n'
            '    target = "content"\n'
        )
        report_missing(convert(note, bundle, draft=True))
        server = subprocess.Popen(
            ["mise", "exec", "--", "hugo", "server", "--buildDrafts", "--renderToMemory",
             "--port", str(port), "--config", f"hugo.toml,{tmp / 'preview.toml'}"],
            cwd=REPO, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
        )
        url = f"http://localhost:{port}/notes/{slug}/"
        for _ in range(60):
            if server.poll() is not None:
                sys.exit("Hugo failed to start:\n" + server.stderr.read())
            try:
                urllib.request.urlopen(url, timeout=1)
                break
            except OSError:
                time.sleep(0.5)
        print(f"Previewing {title}: {url}")
        print("Save in Obsidian and the page reloads. Ctrl+C to stop.")
        webbrowser.open(url)

        last = note.stat().st_mtime
        try:
            while server.poll() is None:
                time.sleep(0.4)
                mtime = note.stat().st_mtime if note.exists() else last
                if mtime != last:
                    last = mtime
                    report_missing(convert(note, bundle, draft=True))
                    print(time.strftime("%H:%M:%S"), "updated")
        except KeyboardInterrupt:
            print("\nPreview stopped. Nothing was written to the repo.")
        finally:
            server.terminate()
            server.wait()


def main():
    parser = argparse.ArgumentParser(description="Publish an Obsidian note on the site.")
    parser.add_argument("note", help="path to the note (.md)")
    parser.add_argument("--preview", action="store_true", help="show the note on a local copy of the site while you edit it")
    parser.add_argument("--port", type=int, default=1313, help="port for --preview (default 1313)")
    args = parser.parse_args()

    note = Path(args.note).expanduser().resolve()
    if not note.is_file():
        sys.exit(f"Note not found: {note}")
    if args.preview:
        preview(note, args.port)
    else:
        publish(note)


if __name__ == "__main__":
    main()
