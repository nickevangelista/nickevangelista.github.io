#!/usr/bin/env python3
"""Publica uma nota do Obsidian como post do site.

Uso: publicar "caminho/da/Nota.md"

Cria content/posts/<slug>/index.md, converte o que é só do Obsidian
([[links]], ![[imagens]], %%comentários%%), copia as imagens pra junto do post,
testa o build do Hugo, faz o commit e pergunta antes do push.
"""

import re
import shutil
import subprocess
import sys
import tempfile
import unicodedata
from datetime import date
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
POSTS = REPO / "content" / "posts"


def slugify(text):
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def find_vault(note):
    for parent in note.parents:
        if (parent / ".obsidian").is_dir():
            return parent
    return note.parent


def find_file(name, note, vault):
    direct = (note.parent / name).resolve()
    if direct.is_file():
        return direct
    for found in vault.rglob(Path(name).name):
        if ".trash" not in found.parts:
            return found
    return None


def split_front_matter(text):
    m = re.match(r"^---\n(.*?)\n---\n?", text, re.S)
    if not m:
        return [], text
    return m.group(1).splitlines(), text[m.end():]


def set_field(lines, key, value, overwrite):
    for i, line in enumerate(lines):
        if re.match(rf"^{key}\s*:", line):
            if overwrite:
                lines[i] = f"{key}: {value}"
            return
    lines.append(f"{key}: {value}")


def get_field(lines, key):
    for line in lines:
        m = re.match(rf"^{key}\s*:\s*(.*)$", line)
        if m:
            return m.group(1).strip().strip("\"'")
    return None


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    note = Path(sys.argv[1]).expanduser().resolve()
    if not note.is_file():
        sys.exit(f"Nota não encontrada: {note}")
    vault = find_vault(note)

    meta, body = split_front_matter(note.read_text())
    title = get_field(meta, "title") or note.stem
    slug = slugify(title)
    bundle = POSTS / slug
    old_post = bundle / "index.md"
    if (POSTS / f"{slug}.md").exists():
        sys.exit(f"Já existe content/posts/{slug}.md. Renomeia a nota ou apaga o post antigo.")

    # Republicar mantém a data original.
    old_date = get_field(split_front_matter(old_post.read_text())[0], "date") if old_post.exists() else None
    set_field(meta, "title", f'"{title}"', overwrite=True)
    set_field(meta, "date", old_date or date.today().isoformat(), overwrite=old_date is not None)
    set_field(meta, "draft", "false", overwrite=True)

    bundle.mkdir(parents=True, exist_ok=True)
    missing = []

    def copy_image(name):
        src = find_file(name, note, vault)
        if not src:
            missing.append(name)
            return name
        dest = slugify(src.stem) + src.suffix.lower()
        shutil.copy2(src, bundle / dest)
        return dest

    def embed(m):
        target = m.group(1).split("|")[0].strip()
        if Path(target).suffix.lower() in {".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg"}:
            return f"![]({copy_image(target)})"
        missing.append(target)
        return ""

    def markdown_image(m):
        alt, target = m.group(1), m.group(2)
        if re.match(r"^[a-z]+://", target):
            return m.group(0)
        return f"![{alt}]({copy_image(target)})"

    def wikilink(m):
        target, _, alias = m.group(1).partition("|")
        return alias or target.split("#")[0]

    body = re.sub(r"%%.*?%%", "", body, flags=re.S)
    body = re.sub(r"!\[([^\]]*)\]\(([^)\s]+)\)", markdown_image, body)
    body = re.sub(r"!\[\[(.+?)\]\]", embed, body)
    body = re.sub(r"\[\[(.+?)\]\]", wikilink, body)

    old_post.write_text("---\n" + "\n".join(meta) + "\n---\n\n" + body.lstrip())
    rel = old_post.relative_to(REPO)
    print(f"Post escrito em {rel}")
    if missing:
        print("Atenção, não achei estes arquivos (o resto do post foi convertido):")
        for name in missing:
            print(f"  - {name}")

    with tempfile.TemporaryDirectory() as out:
        build = subprocess.run(["mise", "exec", "--", "hugo", "--quiet", "-d", out], cwd=REPO)
    if build.returncode != 0:
        sys.exit("O build do Hugo falhou. Nada foi commitado.")

    subprocess.run(["git", "add", str(bundle)], cwd=REPO, check=True)
    if subprocess.run(["git", "diff", "--cached", "--quiet"], cwd=REPO).returncode == 0:
        print("Nada mudou desde a última publicação.")
        return
    subprocess.run(["git", "commit", "-q", "-m", f"post: {title}"], cwd=REPO, check=True)
    print(f"Commit feito. Pra ver antes: cd {REPO} && ./run_hugo.sh")

    if input("Dar push e publicar agora? [s/N] ").strip().lower() == "s":
        subprocess.run(["git", "push"], cwd=REPO, check=True)
        print("Enviado. O site atualiza em ~2 min: https://nickevangelista.github.io/blog/")
    else:
        print("Sem push. Quando quiser: git push")


if __name__ == "__main__":
    main()
